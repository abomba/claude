{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qceval evaluation result",
  "type": "object",
  "required": ["schema_version", "sample_id", "evaluator", "verdict", "thresholds", "context",
               "checks", "reasons", "advisory", "notes", "unused_inputs", "inputs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "sample_id": { "type": "string", "minLength": 1 },
    "evaluator": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "qceval" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "verdict": { "enum": ["PASS", "WARN", "FAIL"] },
    "thresholds": {
      "type": "object",
      "required": ["file", "sha256", "profile", "read_length_profile", "species", "chain"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "profile": { "type": "string", "minLength": 1 },
        "read_length_profile": { "type": ["string", "null"] },
        "species": { "type": ["string", "null"] },
        "chain": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "context": {
      "type": "object",
      "required": ["expected_taxid", "read_length", "depth_basis"],
      "additionalProperties": false,
      "properties": {
        "expected_taxid": { "type": ["integer", "null"], "minimum": 1 },
        "read_length": { "type": ["number", "null"] },
        "depth_basis": { "enum": ["seqkit.total_length", "quast.total_length", "genome_size", null] }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "value", "unit", "rule", "required", "status", "reason"],
        "additionalProperties": false,
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "string", "null"] },
          "unit": { "type": ["string", "null"] },
          "rule": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "enum": ["min", "max", "warn_min", "warn_max", "expected_taxid"] },
            "additionalProperties": { "type": "number" }
          },
          "required": { "type": "boolean" },
          "status": { "enum": ["PASS", "WARN", "FAIL", "NA"] },
          "reason": { "type": ["string", "null"] }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "PASS" } } },
            "then": { "properties": { "reason": { "type": "null" } } },
            "else": { "properties": { "reason": { "type": "string", "minLength": 1 } } }
          },
          {
            "if": { "properties": { "status": { "const": "NA" } } },
            "then": { "properties": { "required": { "const": false }, "value": { "type": "null" } } }
          }
        ]
      }
    },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "advisory": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "unused_inputs": { "type": "array", "items": { "type": "string" } },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "tool", "namespace", "status", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "tool": { "type": "string", "minLength": 1 },
          "namespace": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ok", "empty", "skipped", "failed", "missing"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
